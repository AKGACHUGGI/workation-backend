# 복사해서 .env 로 쓴다. .env 는 커밋하지 않는다. 값은 데이터 담당에게 직접 받는다 (이슈 #2).
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Supabase Session pooler (포트 5432). Transaction pooler(6543)는 쓰지 않는다.
DB_HOST=
DB_PORT=5432
DB_NAME=postgres
DB_USER=
DB_PASSWORD=
DB_SSLMODE=require

# 로컬 테스트 DB 포트 (compose.yaml · config/settings_test.py 공통). 5432 가 사용 중이면 5433
# TEST_DB_PORT=5433
