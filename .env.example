# 복사해서 .env 로 쓴다. .env 는 커밋하지 않는다. 값은 데이터 담당에게 직접 받는다 (이슈 #2).
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Supabase Session pooler (포트 5432). Transaction pooler(6543)는 쓰지 않는다.
DB_HOST=
DB_PORT=5432
DB_NAME=postgres
DB_USER=
DB_PASSWORD=
DB_SSLMODE=require
# 연결 재사용 초. 기본: DEBUG 면 0(요청마다 닫음), 아니면 60. Session pooler 동시 연결 한도 15
# DB_CONN_MAX_AGE=60

# 웹 개발 서버 외에 허용할 출처 (쉼표 구분). 기본값 localhost:5173
# CORS_ALLOWED_ORIGINS=http://localhost:5173,https://<배포 도메인>

# CLOVA Studio 키 (자연어 검색). 없으면 규칙 파서로만 동작
CLOVA_API_KEY=

# 로컬 테스트 DB 포트 (compose.yaml · config/settings_test.py 공통). 5432 가 사용 중이면 5433
# TEST_DB_PORT=5433
