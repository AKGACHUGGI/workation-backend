# 복사해서 .env 로 쓴다. .env 는 커밋하지 않는다. 값은 데이터 담당에게 직접 받는다 (이슈 #2).
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Supabase Session pooler (포트 5432). Transaction pooler(6543)는 쓰지 않는다.
DB_HOST=
DB_PORT=5432
DB_NAME=postgres
DB_USER=
DB_PASSWORD=
DB_SSLMODE=require
# 연결 풀. 프로세스마다 최대 DB_POOL_MAX 개 (기본 4). Session pooler 동시 연결 한도 15 안에서
# 프로세스 수 × DB_POOL_MAX 를 정한다. 풀을 끄면(DB_POOL=false) DB_CONN_MAX_AGE 로 재사용
# DB_POOL=true
# DB_POOL_MAX=4
# 풀을 끈 경우의 연결 재사용 초. 기본: DEBUG 면 0(요청마다 닫음), 아니면 60
# DB_CONN_MAX_AGE=60

# 웹 개발 서버 외에 허용할 출처 (쉼표 구분). 기본값 localhost:5173
# CORS_ALLOWED_ORIGINS=http://localhost:5173,https://<배포 도메인>

# 로그인 (Supabase Auth). 대시보드 Settings → API 의 Project URL · service_role 키
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# 레거시 HS256 프로젝트일 때만 (Settings → JWT Keys 가 비대칭이면 비움)
SUPABASE_JWT_SECRET=

# CLOVA Studio 키 (자연어 검색). 없으면 규칙 파서로만 동작
CLOVA_API_KEY=
# 탐색 그래프 Neo4j. 비어 있으면 /api/explore/* 가 503. 로컬 compose 의 neo4j 는
# 아래 값은 로컬 compose 의 neo4j 기본값 (scripts/explore-local.sh 로 띄운다)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=localpassword
# 팀 공용 Aura 를 쓰면 위 세 값을 Aura 접속 정보로 바꾸고, compose(--profile proxy)용으로 같은 주소를 한 번 더
# NEO4J_URI=neo4j+s://<인스턴스ID>.databases.neo4j.io
# NEO4J_URI_DOCKER=neo4j+s://<인스턴스ID>.databases.neo4j.io

# 캐시 Redis. 비어 있으면 프로세스 메모리 캐시 (워커마다 따로라 throttle 이 워커별로 센다).
# 로컬 compose 의 redis 는 REDIS_URL=redis://localhost:6379/0
REDIS_URL=
# 프록시 뒤 IP 판별 (X-Forwarded-For 에서 뒤에서 몇 번째). Traefik 뒤 배포면 1, 로컬은 비움
DRF_NUM_PROXIES=

# 로컬 테스트 DB 포트 (compose.yaml · config/settings_test.py 공통). 5432 가 사용 중이면 5433
# TEST_DB_PORT=5433

# 사진 업로드 (Cloudflare R2). 값은 데이터 담당에게 받는다. 사용자 사진은 uploads/ 아래에만 쓴다
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
# 사진을 가리는 신고 수 (기본 3)
# PHOTO_REPORT_THRESHOLD=3
